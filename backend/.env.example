# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins (owner web dashboard)
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas (paste YOUR connection string here, in .env only) ----
MONGODB_URI=

# ---- Auth ----
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- OTP / SMS ----
# console  -> prints OTP in server logs (ONLY allowed when NODE_ENV != production)
# msg91 | fast2sms -> real SMS
SMS_PROVIDER=console
SMS_API_KEY=
MSG91_TEMPLATE_ID=

# ---- Cloudinary ----
# Easiest: paste the single value from Cloudinary Console -> API Keys -> "API environment variable":
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@cloud_name
# or fill the three values below (cloud name is case-sensitive and usually lowercase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
